{
  "database": "Zotero",
  "noteImportFolder": "",
  "pdfExportImageDPI": 120,
  "pdfExportImageFormat": "jpg",
  "pdfExportImageQuality": 90,
  "citeFormats": [
    {
      "name": "bib",
      "format": "formatted-bibliography",
      "cslStyle": "harvard-university-of-westminster"
    },
    {
      "name": "cite",
      "format": "pandoc",
      "brackets": true
    }
  ],
  "exportFormats": [
    {
      "name": "Literature Review",
      "outputPathTemplate": "Literature Reviews/{{title | replace(\":\", \",\") | replace(\"/\", \"-\")}}.md",
      "imageOutputPathTemplate": "Assets",
      "imageBaseNameTemplate": "image",
      "templatePath": "FYP/Support Materials/Zotero Templates/Literature Review Template.md"
    }
  ],
  "citeSuggestTemplate": "[[{{citekey}}]]",
  "openNoteAfterImport": false,
  "whichNotesToOpenAfterImport": "first-imported-note"
}