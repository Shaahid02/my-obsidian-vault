        <mxCell id="d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#1B5E20;fontSize=13;" value="&lt;b&gt;Verified data foundation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;turnover reconciled to 0.13% · 99.93% agreement against an independent archive · adjusted panel built · 22,893 announcement-dated filings&lt;/font&gt;" vertex="1">
