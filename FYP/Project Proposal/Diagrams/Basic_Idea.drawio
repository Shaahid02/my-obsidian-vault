        <mxCell id="alab" parent="1" style="text;html=1;align=center;fontSize=11;fontColor=#3B1E54;" value="&lt;font style=&quot;font-size:11px&quot;&gt;each emits &lt;b&gt;direction, magnitude, confidence, status&lt;/b&gt;&lt;/font&gt;" vertex="1">
