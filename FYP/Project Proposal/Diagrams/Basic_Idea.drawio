        <mxCell id="st" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F0EF;strokeColor=#1F7A7A;fontColor=#14524F;fontSize=12;" value="&lt;b&gt;Market state&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;liquidity, volatility, persistence&lt;br&gt;measured from the market, &lt;b&gt;not from any agent&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="92" width="210" x="50" y="440" as="geometry" />
        </mxCell>
        <mxCell id="op" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE3F5;strokeColor=#7030A0;strokeWidth=2;verticalAlign=top;spacingTop=10;fontSize=14;fontColor=#3B1E54;" value="&lt;b&gt;Weighting operator&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face=&quot;Courier New&quot;&gt;w&lt;sub&gt;i,t&lt;/sub&gt; = f(L&lt;sub&gt;t&lt;/sub&gt;, V&lt;sub&gt;t&lt;/sub&gt;, P&lt;sub&gt;t&lt;/sub&gt;, C&lt;sub&gt;i,t&lt;/sub&gt;)&lt;/font&gt;" vertex="1">
          <mxGeometry height="422" width="400" x="350" y="110" as="geometry" />
        </mxCell>
        <mxCell id="op1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7030A0;fontColor=#3B1E54;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;1 · Listen more to the channel that is working&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;an agent&#39;s influence rises and falls with measured conditions outside it, continuously, every day&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="356" x="372" y="166" as="geometry" />
        </mxCell>
        <mxCell id="op2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7030A0;fontColor=#3B1E54;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;2 · Abstain when a channel is empty&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;influence falls to a floor rather than to zero, so the agent can recover when its evidence returns&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="356" x="372" y="266" as="geometry" />
        </mxCell>
        <mxCell id="op3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7030A0;fontColor=#3B1E54;fontSize=12;align=left;spacingLeft=10;" value="&lt;b&gt;3 · Remove what cannot be read&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;an unparseable output is dropped entirely. &lt;b&gt;Not the same as abstaining&lt;/b&gt;, and the two are tested apart&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="356" x="372" y="366" as="geometry" />
        </mxCell>
        <mxCell id="opcap" parent="1" style="text;html=1;align=center;fontSize=11;fontColor=#3B1E54;" value="&lt;font style=&quot;font-size:11px&quot;&gt;deliberately &lt;b&gt;low capacity&lt;/b&gt;: a small, readable function, not a network&lt;/font&gt;" vertex="1">
          <mxGeometry height="24" width="356" x="372" y="462" as="geometry" />
        </mxCell>
        <mxCell id="w" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9C2EC;strokeColor=#7030A0;fontColor=#3B1E54;fontSize=12;" value="&lt;b&gt;One weight per agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;they sum to one, and none falls below the floor unless it was unreadable&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="220" x="840" y="196" as="geometry" />
        </mxCell>
