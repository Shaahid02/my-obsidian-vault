<< /JS (\nvar CSE_busy=false;\nvar CSE_doc=this;\nvar CSE_meta=[{"name": "student_name", "layer": ""}, {"name": "student_id", "layer": ""}, {"name": "student_email", "layer": ""}, {"name": "module", "layer": ""}, {"name": "supervisor_name", "layer": ""}, {"name": "supervisor_email", "layer": ""}, {"name": "project_title", "layer": ""}, {"name": "project_start", "layer": ""}, {"name": "project_end", "layer": ""}, {"name": "project_summary", "layer": ""}, {"name": "q_1_1", "layer": ""}, {"name": "approval_reference", "layer": "existing_details"}, {"name": "q_2_1", "layer": "full"}, {"name": "q_2_2", "layer": "full"}, {"name": "q_2_3", "layer": "full"}, {"name": "external_details", "layer": "external_details"}, {"name": "q_3_1", "layer": "full"}, {"name": "q_3_2", "layer": "full"}, {"name": "q_3_3", "layer": "full"}, {"name": "q_3_4", "layer": "full"}, {"name": "q_4_1", "layer": "full"}, {"name": "fieldwork_details", "layer": "fieldwork_details"}, {"name": "q_5_1", "layer": "full"}, {"name": "q_5_2", "layer": "full"}, {"name": "q_5_3", "layer": "full"}, {"name": "q_5_4", "layer": "full"}, {"name": "q_5_5", "layer": "full"}, {"name": "q_5_6", "layer": "full"}, {"name": "q_5_7", "layer": "full"}, {"name": "q_5A_1", "layer": "data"}, {"name": "q_5A_2", "layer": "data"}, {"name": "q_5A_3", "layer": "data"}, {"name": "q_5A_4", "layer": "data"}, {"name": "q_5A_5", "layer": "data"}, {"name": "q_5B_1", "layer": "games"}, {"name": "q_5B_2", "layer": "games"}, {"name": "q_5B_3", "layer": "games"}, {"name": "q_5B_4", "layer": "games"}, {"name": "q_5B_5", "layer": "games"}, {"name": "q_5C_1", "layer": "cyber"}, {"name": "q_5C_2", "layer": "cyber"}, {"name": "q_5C_3", "layer": "cyber"}, {"name": "q_5C_4", "layer": "cyber"}, {"name": "participant_details", "layer": "people"}, {"name": "q_6_1", "layer": "people"}, {"name": "q_6_2", "layer": "people"}, {"name": "q_6_3", "layer": "people"}, {"name": "q_6_4", "layer": "people"}, {"name": "q_6_5", "layer": "people"}, {"name": "q_6_6", "layer": "people"}, {"name": "q_6_7", "layer": "people"}, {"name": "q_7_1", "layer": "consent"}, {"name": "q_7_2", "layer": "consent"}, {"name": "q_7_3", "layer": "consent"}, {"name": "q_7_4", "layer": "consent"}, {"name": "q_7_5", "layer": "consent"}, {"name": "q_7_6", "layer": "consent"}, {"name": "q_7_7", "layer": "consent"}, {"name": "outcome", "layer": ""}, {"name": "confirmation_name", "layer": ""}, {"name": "confirmation_date", "layer": ""}];\nfunction CSE_value\(doc,id\) { var f=doc.getField\('q_'+id.replace\(/\\./g,'_'\)\); return f ? String\(f.value\) : ''; }\nfunction CSE_active\(doc\) {\n var existing=CSE_value\(doc,'1.1'\)==='Yes';\n return {full:!existing,data:!existing&&CSE_value\(doc,'3.2'\)!=='No',\n games:!existing&&CSE_value\(doc,'3.3'\)!=='No',cyber:!existing&&CSE_value\(doc,'3.4'\)!=='No',\n people:!existing&&CSE_value\(doc,'3.1'\)!=='No',consent:!existing&&CSE_value\(doc,'3.1'\)!=='No',\n existing_details:CSE_value\(doc,'1.1'\)!=='No',\n external_details:!existing&&!\(CSE_value\(doc,'2.1'\)==='No'&&CSE_value\(doc,'2.2'\)==='No'&&CSE_value\(doc,'2.3'\)==='No'\),\n fieldwork_details:!existing&&CSE_value\(doc,'4.1'\)!=='No'};\n}\nfunction CSE_result\(doc\) {\n if\(CSE_value\(doc,'1.1'\)==='Yes'\) return 'Existing ethics approval';\n if\(CSE_value\(doc,'1.1'\)!=='No'\) return '';\n var scopes=['3.1','3.2','3.3','3.4','4.1'];\n var i,v,ids=['2.1','2.2','2.3','5.1','5.2','5.3','5.4','5.5','5.6','5.7'];\n for\(i=0;i<scopes.length;i++\){v=CSE_value\(doc,scopes[i]\);if\(v!=='Yes'&&v!=='No'\)return '';}\n if\(CSE_value\(doc,'3.2'\)==='Yes'\)for\(i=1;i<=5;i++\)ids.push\('5A.'+i\);\n if\(CSE_value\(doc,'3.3'\)==='Yes'\)for\(i=1;i<=5;i++\)ids.push\('5B.'+i\);\n if\(CSE_value\(doc,'3.4'\)==='Yes'\)for\(i=1;i<=4;i++\)ids.push\('5C.'+i\);\n if\(CSE_value\(doc,'3.1'\)==='Yes'\)for\(i=1;i<=7;i++\)ids.push\('6.'+i\);\n var review=false;\n for\(i=0;i<ids.length;i++\){v=CSE_value\(doc,ids[i]\);if\(v!=='Yes'&&v!=='No'\)return '';if\(v==='Yes'\)review=true;}\n if\(CSE_value\(doc,'3.1'\)==='Yes'\)for\(i=1;i<=7;i++\){\n  v=CSE_value\(doc,'7.'+i\);if\(v!=='Yes'&&v!=='No'\)return '';if\(v==='No'\)review=true;\n }\n return review?'Ethics review required':'Class 1 sign-off';\n}\nfunction CSE_refresh\(doc\) {\n if\(CSE_busy\)return;CSE_busy=true;\n try {\n  var active=CSE_active\(doc\),layers=doc.getOCGs?doc.getOCGs\(\):null,i,f,name;\n  if\(layers\)for\(i=0;i<layers.length;i++\){name=layers[i].name.replace\(/^CSE_/,''\);if\(typeof active[name]!=='undefined'\)layers[i].state=active[name];}\n  for\(i=0;i<CSE_meta.length;i++\){f=doc.getField\(CSE_meta[i].name\);if\(f&&CSE_meta[i].layer\)f.display=active[CSE_meta[i].layer]?display.visible:display.hidden;}\n  f=doc.getField\('outcome'\);if\(f\){f.readonly=false;f.value=CSE_result\(doc\);}\n }catch\(e\){}finally{CSE_busy=false;}\n}\nfunction CSE_portable\(doc\) {\n // Persist an editable, fully visible fallback for viewers without JavaScript.\n var layers=doc.getOCGs?doc.getOCGs\(\):null,i,f;\n if\(layers\)for\(i=0;i<layers.length;i++\)layers[i].state=true;\n for\(i=0;i<CSE_meta.length;i++\){f=doc.getField\(CSE_meta[i].name\);if\(f\)f.display=display.visible;}\n f=doc.getField\('outcome'\);if\(f\)f.readonly=false;\n}\nCSE_refresh\(this\);\n) /S /JavaScript /Type /Action >>
endobj
