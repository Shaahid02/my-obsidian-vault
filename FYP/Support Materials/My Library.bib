  title = {The {{Impact}} of {{Firm-Specific Factors}} on {{Share Prices}} of {{Diversified Financial Companies}}: {{Evidence}} from the {{Colombo Stock Exchange}}},
  shorttitle = {The {{Impact}} of {{Firm-Specific Factors}} on {{Share Prices}} of {{Diversified Financial Companies}}},
