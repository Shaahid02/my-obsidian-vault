}

@article{somathilakaLongTermImpactMacroeconomic2025,
  title = {The {{Long-Term Impact}} of {{Macroeconomic Stability Variables}} on {{Stock Price Volatility}}},
  author = {Somathilaka, H. P. A. D. and Hewamana, H. M. R. R.},
