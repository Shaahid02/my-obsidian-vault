@article{sheikhTRIAGTrireinforcedInfused2026,
  title = {{{TRIAG}}: {{Tri}}-Reinforced Infused Generative Agents for Financial Risk Compliance},
  shorttitle = {{{TRIAG}}},
  author = {Sheikh, Rafsun and Miah, Shah J},
  year = 2026,
