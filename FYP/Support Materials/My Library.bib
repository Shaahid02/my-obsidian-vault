@article{dissanayakeRelationshipMacroeconomicVariables2026,
  title = {The {{Relationship}} between {{Macroeconomic Variables}}, {{Trading Volume}} and {{Stock Returns}}: {{Granger Causality Evidence}} from the {{Colombo Stock Exchange}}},
  shorttitle = {The {{Relationship}} between {{Macroeconomic Variables}}, {{Trading Volume}} and {{Stock Returns}}},
  author = {Dissanayake, M. B. and Rathnayake, S. S. and Panditharathna, K. M.},
  year = 2026,
